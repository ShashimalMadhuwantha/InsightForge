# JWT Secrets
JWT_SECRET=super_secret_jwt_key_change_for_production_insightforge_2026
JWT_REFRESH_SECRET=super_secret_jwt_refresh_key_change_for_production_2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
