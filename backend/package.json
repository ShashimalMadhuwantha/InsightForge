{
  "name": "insightforge-backend",
  "version": "1.0.0",
  "description": "Multi-Tenant BI SaaS Platform Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "cross-env NODE_ENV=test jest --runInBand --detectOpenHandles --forceExit",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage --forceExit",
    "migrate:make": "knex --knexfile src/common/config/knexfile.js migrate:make -x js",
    "migrate:up": "knex --knexfile src/common/config/knexfile.js migrate:latest",
    "migrate:down": "knex --knexfile src/common/config/knexfile.js migrate:rollback",
    "migrate:status": "knex --knexfile src/common/config/knexfile.js migrate:status",
    "migrate:rollback:all": "knex --knexfile src/common/config/knexfile.js migrate:rollback --all",
    "seed:make": "knex --knexfile src/common/config/knexfile.js seed:make -x js",
    "seed:run": "knex --knexfile src/common/config/knexfile.js seed:run",
    "lint": "eslint \"src/**/*.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/ioredis-mock": "^8.2.8",
    "cross-env": "^7.0.3",
    "eslint": "^9.17.0",
    "ioredis-mock": "^8.9.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "globalTeardown": "<rootDir>/src/tests/teardown.js",
    "testMatch": [
      "**/__tests__/**/*.js",
      "**/?(*.)+(spec|test).js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/"
    ]
  }
}
